  "cards": [
    {
      "dot": "cyan",
      "title": "双轨数据摄取",
      "items": [
        "时序全语义轨：yt-dlp 抓取原片与 CC 字幕，清洗为秒级时间戳文稿",
        "事件自适应视觉轨：ffmpeg gt(scene,0.35) 提取 15~30 张场景突变帧",
        "图文降级前置：彻底剔除口述面部特写与风光氛围低熵垫片"
      ]
    },
    {
      "dot": "emerald",
      "title": "认知提炼与视觉锚定",
      "items": [
        "图文降级铁律：大字课件与对比清单强制降维转化为三级树或微表格",
        "原子化三层语法：核心概念 (英文原名) -> 底层运作机制 -> 参数量化指标",
        "自适应视觉锚定：全景纯景、局部微观焦点、双端平权对峙、时序胶卷"
      ]
    },
    {
      "dot": "violet",
      "title": "独立交互式交付",
      "items": [
        "单文件自包含 HTML：内置 Tokyo Night 深色拟态与 Clean Minimal 浅色",
        "电影级图片灯箱：支持点击放大、平移缩放 (Pan & Zoom) 与 1:1 像素级还原",
        "多端格式导出：浏览器端纯前端一键导出原生 .xmind 文件与高清 SVG/PNG"
      ]
    }
  ]
